# Template for esphome/secrets.yaml (gitignored): copy it, then put the real values there.
# Configs reference them with !secret <name>.
wifi_ssid: "<WIFI_SSID>"
wifi_password: "<WIFI_PASSWORD>"
api_encryption_key: "<BASE64_32_BYTES>" # esphome generates one: see the native API docs
ota_password: "<OTA_PASSWORD>"
